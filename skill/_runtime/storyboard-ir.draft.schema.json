{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-ir-draft-phase6",
  "title": "Storyboard IR Draft Shadow Schema",
  "description": "Model-independent director-decision shadow IR. Not a generation output contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "scenes"],
  "properties": {
    "schema_version": {
      "const": "storyboard-ir-draft/0.1-shadow"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    },
    "legacy_extensions": {
      "$ref": "#/$defs/legacyExtensions"
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "end"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1}
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_id", "description", "source_ref"],
      "properties": {
        "beat_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "display_name"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "initial_state": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "duration_seconds"],
      "properties": {
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale"],
      "properties": {
        "scale": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewpoint", "angle", "movement"],
      "properties": {
        "viewpoint": {"type": "string", "minLength": 1},
        "angle": {"type": "string", "minLength": 1},
        "movement": {"type": "string", "minLength": 1},
        "details": {
          "type": "string",
          "minLength": 1,
          "description": "LEGACY_IMPORT migration safety only; forbidden by GENERATION_READY."
        },
        "expanded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_reason", "facts"],
          "properties": {
            "risk_reason": {"type": "string", "minLength": 1},
            "facts": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "audioEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "kind", "shot_refs", "description"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "legacy_event_id": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["dialogue", "sound", "ambience", "music_constraint", "audio_constraint", "unknown"]
        },
        "shot_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "speaker_ref": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "delivery": {"type": "string", "minLength": 1},
        "visibility": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_preserve": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "prohibited": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "minProperties": 1
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "subject_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "order",
        "source_beats",
        "narrative_purpose",
        "duration",
        "subjects",
        "framing",
        "camera",
        "blocking_action"
      ],
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "source_beats": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "narrative_purpose": {"type": "string", "minLength": 1},
        "duration": {"$ref": "#/$defs/duration"},
        "subjects": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "framing": {"$ref": "#/$defs/framing"},
        "camera": {"$ref": "#/$defs/camera"},
        "blocking_action": {"$ref": "#/$defs/summary"},
        "composition": {"$ref": "#/$defs/summary"},
        "visual_emphasis": {"type": "string", "minLength": 1},
        "dialogue_audio": {
          "type": "array",
          "items": {"$ref": "#/$defs/audioEvent"}
        },
        "spatial_relation": {"$ref": "#/$defs/summary"},
        "continuity_delta": {
          "$ref": "#/$defs/continuity",
          "description": "Only a state change explicitly assigned to this shot; never inferred from scene end state."
        },
        "generation_constraints": {"$ref": "#/$defs/constraints"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "source_ref", "required_beats", "scene_objective", "shots"],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "source_ref": {"$ref": "#/$defs/sourceRef"},
        "required_beats": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/beat"}
        },
        "scene_objective": {"type": "string", "minLength": 1},
        "subject_registry": {
          "type": "array",
          "items": {"$ref": "#/$defs/subject"}
        },
        "spatial_anchor": {"$ref": "#/$defs/summary"},
        "initial_state": {"$ref": "#/$defs/summary"},
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/shot"}
        },
        "audio_plan": {
          "type": "array",
          "items": {"$ref": "#/$defs/audioEvent"}
        },
        "continuity_end_state": {"$ref": "#/$defs/continuity"},
        "generation_constraints": {"$ref": "#/$defs/constraints"}
      }
    },
    "legacyExtensions": {
      "type": "object",
      "required": ["classification", "migration_status", "source_format", "original_document_sha256", "original_document", "module_passthrough"],
      "properties": {
        "classification": {"const": "LEGACY_ONLY"},
        "migration_status": {"const": "LEGACY_EXTENSION"},
        "source_format": {"const": "v0.3.31-11-module"},
        "original_document_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "original_document": {"type": "string"},
        "document_prefix": {"type": "string"},
        "scene_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scene_id", "text"],
            "properties": {
              "scene_id": {"type": "string"},
              "text": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "module_passthrough": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scene_id", "module_number", "module_title", "text", "classification", "migration_status"],
            "properties": {
              "scene_id": {"type": "string"},
              "module_number": {"type": "integer", "minimum": 1, "maximum": 11},
              "module_title": {"type": "string"},
              "text": {"type": "string"},
              "classification": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["IR", "ADAPTER", "WORKFLOW", "QA", "LEGACY_PRESENTATION", "UNKNOWN"]
                }
              },
              "migration_status": {
                "type": "string",
                "enum": ["MAPPED_TO_IR", "MAPPED_TO_ADAPTER_FUTURE", "MAPPED_TO_WORKFLOW_FUTURE", "LEGACY_PRESENTATION_ONLY", "LEGACY_EXTENSION", "UNRESOLVED_SEMANTIC"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
